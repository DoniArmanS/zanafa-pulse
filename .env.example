# Dipakai docker-compose.yml. Salin menjadi .env di folder yang sama, lalu ganti password.
# File .env TIDAK di-commit.

POSTGRES_DB=zanafa
POSTGRES_USER=zanafa
POSTGRES_PASSWORD=ganti-password-ini

# Port di komputer/VPS untuk membuka aplikasi: http://localhost:8080
WEB_PORT=8080

# Email stok menipis, dibaca docker-compose.lokal.yml. Tanpa diisi, email ditampung Mailpit (http://localhost:8025).
# EMAIL_OWNER=owner@contoh.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=alamat@gmail.com
# SMTP_PASS=app-password-16-huruf
