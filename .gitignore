# ============================================
# .gitignore - Zanafa Bookstore System
# Dirapikan lagi nanti setelah tech stack fix
# ============================================

# ---------- Dokumentasi & referensi (bukan kode) ----------
Dokumentasi/

# ---------- Instruksi lokal Claude (bukan kode, tidak perlu ikut repo) ----------
CLAUDE.md

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Environment & secrets ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
.next/
.nuxt/
.turbo/
coverage/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- PHP / Laravel ----------
vendor/
composer.phar
.phpunit.result.cache
storage/*.key
public/hot
public/storage
/storage/framework/**
/storage/logs/**
/bootstrap/cache/*.php

# ---------- Database ----------
*.sqlite
*.sqlite3
*.db

# ---------- Logs ----------
*.log
logs/

# ---------- Uploads / generated files (rapikan sesuai kebutuhan nanti) ----------
uploads/
tmp/
