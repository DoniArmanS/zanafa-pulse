# Salin menjadi .env untuk menjalankan backend langsung dengan `go run`.
# File .env TIDAK di-commit (sudah ada di .gitignore).

APP_ENV=development
APP_PORT=8081

# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DB?sslmode=disable
DATABASE_URL=postgres://zanafa:ganti-password-ini@localhost:5432/zanafa?sslmode=disable

# Isi agar server ikut menyajikan frontend di http://localhost:8081 (tanpa NGINX).
FRONTEND_DIR=../frontend

MIGRASI_OTOMATIS=true
LAMA_SESI=12h

# Email stok menipis. Kosongkan SMTP_HOST kalau belum mau mengirim email.
# Mailpit di laptop: SMTP_HOST=localhost SMTP_PORT=1025
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true, SMTP_PASS = App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_PENGIRIM=Zanafa Pulse <no-reply@zanafa.local>
# Penerima peringatan (Owner). Boleh beberapa, pisahkan dengan koma.
EMAIL_OWNER=
# Alamat aplikasi, dipakai untuk tautan di dalam email.
APP_URL=http://localhost:8081
# Selang kirim ulang email yang gagal (menit). 0 = tidak dicoba ulang.
NOTIFIKASI_ULANG_MENIT=5
